<footer class="toy-footer footer" data-section-id="{{ section.id }}" data-toy-footer>
  <div class="toy-footer__world" data-toy-footer-parallax="0.14" aria-hidden="true">
    {% if section.settings.illustration != blank %}
      {{ section.settings.illustration | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '900, 1400, 1900, 2400', alt: '' }}
    {% else %}
      <img src="{{ 'toy-store-footer-world.png' | asset_url }}" alt="" width="2172" height="724" loading="lazy">
    {% endif %}
  </div>
  <span class="toy-footer__star toy-footer__star--one" data-toy-footer-parallax="0.35" aria-hidden="true">★</span>
  <span class="toy-footer__star toy-footer__star--two" data-toy-footer-parallax="-0.22" aria-hidden="true">✦</span>

  <div class="toy-footer__content page-width">
    <div class="toy-footer__cta" data-toy-reveal>
      <div>
        {% if section.settings.kicker != blank %}<p>{{ section.settings.kicker | escape }}</p>{% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="toy-footer__intro">{{ section.settings.text }}</div>
      </div>
      <div class="toy-footer__newsletter">
        <h3>{{ section.settings.newsletter_heading | escape }}</h3>
        {% render 'newsletter-form' %}
      </div>
    </div>

    <div class="toy-footer__links" data-toy-reveal>
      <div class="toy-footer__brand">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 240, 320', alt: shop.name }}
        {% else %}
          <img src="{{ 'bababo-logo.png' | asset_url }}" alt="Bababo Kids — Onde a imaginação cria asas!" width="280" height="171" loading="lazy">
        {% endif %}
        <p>{{ section.settings.brand_text | escape }}</p>
        {% if section.settings.show_social %}
          <ul class="toy-footer__social" role="list">
            {% if settings.social_instagram_link != blank %}<li><a href="{{ settings.social_instagram_link }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a></li>{% endif %}
            {% if settings.social_facebook_link != blank %}<li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a></li>{% endif %}
          </ul>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'menu' %}
            <div class="toy-footer__column" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading | escape }}</h3>
              {% if block.settings.menu != blank %}
                <ul role="list">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>
              {% else %}
                <ul role="list">
                  <li><a href="{{ routes.all_products_collection_url }}">Todos os brinquedos</a></li>
                  <li><a href="{{ routes.collections_url }}">Categorias</a></li>
                  <li><a href="{{ routes.search_url }}">Buscar presentes</a></li>
                </ul>
              {% endif %}
            </div>
          {% when 'text' %}
            <div class="toy-footer__column" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading | escape }}</h3>
              <div class="rte">{{ block.settings.text }}</div>
            </div>
        {% endcase %}
      {% endfor %}

      {% if section.blocks.size == 0 %}
        <div class="toy-footer__column"><h3>Descubra</h3><ul role="list"><li><a href="{{ routes.all_products_collection_url }}">Todos os brinquedos</a></li><li><a href="{{ routes.collections_url }}">Categorias</a></li><li><a href="{{ routes.search_url }}">Buscar presentes</a></li></ul></div>
        <div class="toy-footer__column"><h3>Ajuda</h3><ul role="list"><li><a href="{{ routes.account_url }}">Minha conta</a></li><li><a href="{{ routes.cart_url }}">Meu carrinho</a></li><li><a href="/pages/contact">Fale com a gente</a></li></ul></div>
      {% endif %}
    </div>

    <div class="toy-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Onde a imaginação cria asas!</p>
      <div class="toy-footer__utilities">
        {% if section.settings.enable_localization %}{% render 'localization-form', section_id: section.id, show_country: true, show_language: true %}{% endif %}
        {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
          <ul class="toy-footer__payment" role="list" aria-label="Formas de pagamento">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé infantil ilustrado",
  "settings": [
    { "type": "image_picker", "id": "illustration", "label": "Ilustração de fundo" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "kicker", "label": "Chamada pequena", "default": "Onde a imaginação cria asas!" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Novidades para voar em novas aventuras" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Receba lançamentos, ideias de presentes e ofertas para brincar, imaginar e descobrir.</p>" },
    { "type": "text", "id": "newsletter_heading", "label": "Título da newsletter", "default": "Entre para a brincadeira" },
    { "type": "text", "id": "brand_text", "label": "Texto da marca", "default": "Brinquedos escolhidos para dar asas à imaginação e criar memórias felizes em família." },
    { "type": "checkbox", "id": "show_social", "label": "Mostrar redes sociais", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar pagamentos", "default": true },
    { "type": "checkbox", "id": "enable_localization", "label": "Mostrar país e idioma", "default": false }
  ],
  "blocks": [
    { "type": "menu", "name": "Coluna de menu", "settings": [
      { "type": "text", "id": "heading", "label": "Título", "default": "Descubra" },
      { "type": "link_list", "id": "menu", "label": "Menu" }
    ] },
    { "type": "text", "name": "Coluna de texto", "settings": [
      { "type": "text", "id": "heading", "label": "Título", "default": "Atendimento" },
      { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Segunda a sexta, das 9h às 18h.</p>" }
    ] }
  ],
  "presets": [{ "name": "Rodapé infantil ilustrado", "blocks": [{ "type": "menu" }, { "type": "text" }] }],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
