{{ 'bababo-editable.css' | asset_url | stylesheet_tag }}

{% liquid
  if section.settings.collection != blank
    assign featured_collection = section.settings.collection
  else
    assign featured_collection = collections.all
  endif
%}

<section class="bababo-section" style="background: {{ section.settings.background }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="bababo-shell">
    <div class="bababo-heading">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}
      </div>
      {% if section.settings.link_label != blank %}<a href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>{% endif %}
    </div>

    <div class="bababo-scroll-row">
      {% if featured_collection.products_count > 0 %}
        {% for product in featured_collection.products limit: section.settings.product_limit %}
          <article class="bababo-card bababo-product-card">
            <a class="bababo-media" href="{{ product.url }}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 460 | image_tag: loading: 'lazy', alt: product.title }}
              {% else %}
                <span class="bababo-demo-icon">{{ section.settings.fallback_icon }}</span>
              {% endif %}
            </a>
            {% if section.settings.show_rating %}<div class="bababo-rating">{{ section.settings.rating_text }}</div>{% endif %}
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="bababo-price">{{ product.price | money }}</p>
            {% if section.settings.show_add_button %}
              {% form 'product', product %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button class="bababo-add" type="submit">{{ section.settings.add_label }}</button>
              {% endform %}
            {% endif %}
          </article>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          <article class="bababo-card bababo-product-card" {{ block.shopify_attributes }}>
            <div class="bababo-media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 460 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {% else %}
                <span class="bababo-demo-icon">{{ block.settings.icon }}</span>
              {% endif %}
            </div>
            {% if section.settings.show_rating %}<div class="bababo-rating">{{ section.settings.rating_text }}</div>{% endif %}
            <h3>{{ block.settings.title }}</h3>
            <p class="bababo-price">{{ block.settings.price }}</p>
            {% if section.settings.show_add_button %}
              <a class="bababo-add bababo-button" href="{{ block.settings.link }}">{{ section.settings.add_label }}</a>
            {% endif %}
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bababo - Vitrine",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Produtos em destaque" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Conecte uma coleção no editor da Shopify para exibir produtos reais." },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "product_limit", "label": "Quantidade de produtos reais", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_rating", "label": "Mostrar avaliação visual", "default": true },
    { "type": "text", "id": "rating_text", "label": "Texto da avaliação", "default": "★★★★★" },
    { "type": "checkbox", "id": "show_add_button", "label": "Mostrar botão de compra", "default": true },
    { "type": "text", "id": "add_label", "label": "Texto do botão", "default": "adicionar ao carrinho" },
    { "type": "text", "id": "fallback_icon", "label": "Ícone fallback para produto sem imagem", "default": "🎁" },
    { "type": "text", "id": "link_label", "label": "Texto do link", "default": "ver vitrine" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "color", "id": "background", "label": "Fundo", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "demo_product",
      "name": "Produto demonstrativo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "icon", "label": "Ícone quando não houver imagem", "default": "🦖" },
        { "type": "text", "id": "title", "label": "Título", "default": "Mordedor Dinossauro Dino T-Rex" },
        { "type": "text", "id": "price", "label": "Preço", "default": "R$ 18,30" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bababo - Vitrine",
      "blocks": [
        { "type": "demo_product", "settings": { "icon": "🦖", "title": "Mordedor Dinossauro Dino T-Rex", "price": "R$ 18,30" } },
        { "type": "demo_product", "settings": { "icon": "🔫", "title": "Arminha Brinquedo Space Gun", "price": "R$ 24,90" } },
        { "type": "demo_product", "settings": { "icon": "💇", "title": "Secador de Cabelo Infantil", "price": "R$ 65,50" } },
        { "type": "demo_product", "settings": { "icon": "🦄", "title": "Kit Maquiagem Infantil", "price": "R$ 28,90" } },
        { "type": "demo_product", "settings": { "icon": "🚗", "title": "Réplica Carrinho Fusca 1967", "price": "R$ 25,30" } },
        { "type": "demo_product", "settings": { "icon": "🍼", "title": "Mordedor Pezinho Silicone", "price": "R$ 20,30" } }
      ]
    }
  ]
}
{% endschema %}
