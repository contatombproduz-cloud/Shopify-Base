{{ 'toy-store.css' | asset_url | stylesheet_tag }}

<section class="toy-hero-wrap" data-toy-parallax-section style="--toy-hero-height: {{ section.settings.height }}px;">
  <div class="toy-shell">
    <div class="toy-hero" data-toy-tilt>
      <div class="toy-hero__media" data-toy-parallax="0.12">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '768, 1200, 1800, 2400', sizes: '(min-width: 1800px) 1600px, calc(100vw - 32px)', alt: section.settings.image_alt }}
        {% else %}
          <img src="{{ 'toy-store-hero-3d.png' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="2172" height="724" loading="eager" fetchpriority="high">
        {% endif %}
      </div>
      <span class="toy-hero__cloud toy-hero__cloud--one" data-toy-parallax="0.3" aria-hidden="true"></span>
      <span class="toy-hero__cloud toy-hero__cloud--two" data-toy-parallax="-0.18" aria-hidden="true"></span>
      <div class="toy-hero__content" data-toy-parallax="-0.06">
        {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h1>{{ section.settings.heading | escape }} <strong>{{ section.settings.highlight | escape }}</strong></h1>
        {% if section.settings.text != blank %}<div class="toy-hero__text">{{ section.settings.text }}</div>{% endif %}
        <div class="toy-hero__buttons">
          {% if section.settings.button_label != blank %}<a class="toy-cloud-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
          {% if section.settings.secondary_label != blank %}<a class="toy-hero__secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label | escape }} <span>→</span></a>{% endif %}
        </div>
      </div>
      <div class="toy-hero__scroll" aria-hidden="true"><span></span>role para brincar</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Loja infantil - Hero 3D",
  "tag": "section",
  "class": "toy-home-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem do banner (opcional)" },
    { "type": "text", "id": "image_alt", "label": "Descrição da imagem", "default": "Brinquedos coloridos entre nuvens" },
    { "type": "text", "id": "eyebrow", "label": "Chamada pequena", "default": "Diversão que chega voando" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Um mundo inteiro de" },
    { "type": "text", "id": "highlight", "label": "Palavra em destaque", "default": "brincadeiras" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Presentes incríveis para transformar qualquer dia em uma grande aventura.</p>" },
    { "type": "text", "id": "button_label", "label": "Botão principal", "default": "Explorar brinquedos" },
    { "type": "url", "id": "button_link", "label": "Link principal" },
    { "type": "text", "id": "secondary_label", "label": "Botão secundário", "default": "Ver novidades" },
    { "type": "url", "id": "secondary_link", "label": "Link secundário" },
    { "type": "range", "id": "height", "label": "Altura no desktop", "min": 400, "max": 700, "step": 20, "unit": "px", "default": 520 }
  ],
  "presets": [{ "name": "Loja infantil - Hero 3D" }]
}
{% endschema %}
