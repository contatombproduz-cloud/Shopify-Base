<header class="shopcart-header" data-section-id="{{ section.id }}">
  <div class="shopcart-header__inner page-width">
    <button type="button" class="shopcart-header__menu-toggle tap-target" aria-label="Abrir menu" aria-expanded="false" aria-controls="MobileNav-{{ section.id }}">
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.root_url }}" class="shopcart-header__brand" aria-label="{{ shop.name | escape }} — página inicial">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {{ settings.logo | image_url: width: 600 | image_tag: class: 'shopcart-header__logo', widths: '120, 180, 240, 360, 600', width: settings.logo_width, alt: logo_alt }}
      {%- else -%}
        <span class="shopcart-header__brand-mark" aria-hidden="true">
          <svg viewBox="0 0 42 42"><path d="M8 14h25l-2 17H11L8 14Z" fill="#fff" stroke="currentColor" stroke-width="2"/><path d="M15 14c0-5 2-8 6-8s6 3 6 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="34" r="2.3" fill="#f3a712"/><circle cx="27" cy="34" r="2.3" fill="#e55934"/><path d="m13 18 5 5 10-9" fill="none" stroke="#47a447" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="shopcart-header__brand-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="shopcart-header__nav" aria-label="Navegação principal">
      <ul role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="{% if link.links != blank %}has-submenu{% endif %}">
            <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
              {{ link.title | escape }}
              {%- if link.links != blank -%}<svg aria-hidden="true" viewBox="0 0 12 8"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>{%- endif -%}
            </a>
            {%- if link.links != blank -%}
              <ul class="shopcart-header__submenu" role="list">
                {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>{%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <form action="{{ routes.search_url }}" method="get" role="search" class="shopcart-header__search">
      <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">Buscar produtos</label>
      <input id="HeaderSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Buscar produtos">
      <button type="submit" aria-label="Buscar">{% render 'icon', name: 'search' %}</button>
    </form>

    <div class="shopcart-header__actions">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="shopcart-header__action" aria-label="Minha conta">{% render 'icon', name: 'account' %}<span>Conta</span></a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="shopcart-header__action shopcart-header__cart" aria-label="Carrinho com {{ cart.item_count }} itens">
        {% render 'icon', name: 'cart' %}<span>Carrinho</span><b data-cart-count>{{ cart.item_count }}</b>
      </a>
    </div>
  </div>

  <div class="shopcart-header__mobile-search page-width">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="MobileSearch-{{ section.id }}">Buscar produtos</label>
      <input id="MobileSearch-{{ section.id }}" type="search" name="q" placeholder="Buscar produtos">
      <button type="submit" aria-label="Buscar">{% render 'icon', name: 'search' %}</button>
    </form>
  </div>

  <nav class="shopcart-header__mobile-nav page-width" id="MobileNav-{{ section.id }}" aria-label="Menu móvel" hidden>
    <ul role="list">
      {%- for link in section.settings.menu.links -%}
        <li>
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- if link.links != blank -%}
            <ul role="list">{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>{%- endfor -%}</ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

<style>
  .shopcart-header { position: relative; z-index: 30; background: #fff; border-bottom: 1px solid #eef0ef; }
  .shopcart-header__inner { min-height: 78px; display: grid; grid-template-columns: auto minmax(260px, 1fr) minmax(220px, 360px) auto; align-items: center; gap: clamp(20px, 3vw, 44px); }
  .shopcart-header__brand { min-width: max-content; display: inline-flex; align-items: center; gap: 8px; color: #10251f; text-decoration: none; }
  .shopcart-header__logo { display: block; max-width: 170px; height: auto; }
  .shopcart-header__brand-mark { width: 35px; height: 35px; color: #064a38; }
  .shopcart-header__brand-mark svg { width: 100%; height: 100%; }
  .shopcart-header__brand-name { font-family: var(--font-heading-family); font-size: 23px; font-weight: 800; letter-spacing: -.035em; }
  .shopcart-header__nav > ul { display: flex; align-items: center; gap: clamp(18px, 2.2vw, 34px); margin: 0; padding: 0; list-style: none; }
  .shopcart-header__nav li { position: relative; }
  .shopcart-header__nav a { display: inline-flex; align-items: center; gap: 6px; padding-block: 27px; color: #1f2d28; font-size: 14px; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .shopcart-header__nav a:hover { color: #087359; }
  .shopcart-header__nav svg { width: 9px; }
  .shopcart-header__submenu { position: absolute; top: calc(100% - 14px); left: -16px; min-width: 210px; margin: 0; padding: 8px; list-style: none; border: 1px solid #e3e8e6; border-radius: 12px; background: #fff; box-shadow: 0 16px 36px rgba(12,50,39,.12); opacity: 0; visibility: hidden; transform: translateY(5px); transition: opacity .18s ease, transform .18s ease, visibility .18s; }
  .shopcart-header__submenu a { width: 100%; padding: 10px 12px; border-radius: 7px; }
  .shopcart-header__submenu a:hover { background: #f0f5f3; }
  .has-submenu:hover .shopcart-header__submenu,
  .has-submenu:focus-within .shopcart-header__submenu { opacity: 1; visibility: visible; transform: translateY(0); }
  .shopcart-header__search,
  .shopcart-header__mobile-search form { position: relative; }
  .shopcart-header__search input,
  .shopcart-header__mobile-search input { width: 100%; height: 42px; padding: 10px 46px 10px 18px; border: 0; border-radius: 999px; outline: 1px solid transparent; background: #f4f6f5; color: #172721; font: inherit; font-size: 13px; }
  .shopcart-header__search input:focus,
  .shopcart-header__mobile-search input:focus { outline-color: #7aa194; background: #fff; }
  .shopcart-header__search button,
  .shopcart-header__mobile-search button { position: absolute; inset: 0 6px 0 auto; width: 38px; display: grid; place-items: center; padding: 0; border: 0; background: none; color: #30443d; cursor: pointer; }
  .shopcart-header__search svg,
  .shopcart-header__mobile-search svg { width: 19px; height: 19px; }
  .shopcart-header__actions { display: flex; align-items: center; gap: 18px; }
  .shopcart-header__action { position: relative; display: inline-flex; align-items: center; gap: 7px; min-height: 44px; color: #1b2924; font-size: 13px; font-weight: 700; text-decoration: none; }
  .shopcart-header__action > svg { width: 21px; height: 21px; }
  .shopcart-header__cart b { min-width: 17px; height: 17px; display: grid; place-items: center; margin-left: -4px; padding: 0 4px; border-radius: 9px; background: #064a38; color: #fff; font-size: 10px; line-height: 1; }
  .shopcart-header__menu-toggle,
  .shopcart-header__mobile-search,
  .shopcart-header__mobile-nav { display: none; }

  @media screen and (max-width: 1100px) {
    .shopcart-header__inner { grid-template-columns: auto auto 1fr auto; gap: 16px; }
    .shopcart-header__menu-toggle { display: flex; flex-direction: column; gap: 5px; padding: 10px; border: 0; background: none; }
    .shopcart-header__menu-toggle span { width: 22px; height: 2px; border-radius: 2px; background: #10251f; }
    .shopcart-header__nav { display: none; }
    .shopcart-header__search { max-width: 400px; justify-self: end; width: 100%; }
    .shopcart-header__mobile-nav { display: block; padding-block: 5px 18px; border-top: 1px solid #eef0ef; }
    .shopcart-header__mobile-nav[hidden] { display: none; }
    .shopcart-header__mobile-nav ul { margin: 0; padding: 0; list-style: none; }
    .shopcart-header__mobile-nav > ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px 20px; }
    .shopcart-header__mobile-nav a { display: block; padding: 10px 0; color: #172721; font-weight: 700; text-decoration: none; }
    .shopcart-header__mobile-nav ul ul a { padding: 5px 0; color: #66736e; font-size: 13px; font-weight: 500; }
  }
  @media screen and (max-width: 749px) {
    .shopcart-header__inner { min-height: 68px; grid-template-columns: auto 1fr auto; }
    .shopcart-header__search { display: none; }
    .shopcart-header__mobile-search { display: block; padding-bottom: 12px; }
    .shopcart-header__brand { justify-self: center; }
    .shopcart-header__brand-name { font-size: 20px; }
    .shopcart-header__brand-mark { width: 31px; height: 31px; }
    .shopcart-header__action span { display: none; }
    .shopcart-header__actions { gap: 3px; }
    .shopcart-header__action { min-width: 36px; justify-content: center; }
    .shopcart-header__mobile-nav > ul { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function () {
    var header = document.querySelector('.shopcart-header[data-section-id="{{ section.id }}"]');
    if (!header) return;
    var toggle = header.querySelector('.shopcart-header__menu-toggle');
    var nav = document.getElementById('MobileNav-{{ section.id }}');
    if (!toggle || !nav) return;
    toggle.addEventListener('click', function () {
      var isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menu' : 'Fechar menu');
      nav.hidden = isOpen;
    });
  })();
</script>

{% schema %}
{
  "name": "Cabeçalho Shopcart",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "default": "main-menu", "label": "Menu" }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
