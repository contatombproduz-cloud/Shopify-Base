<aside class="shopcart-announcement" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="shopcart-announcement__inner page-width">
    <a class="shopcart-announcement__item shopcart-announcement__phone" href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M7.3 3.8 9.7 8l-2 1.8c1 2.3 2.8 4.1 5.1 5.1l1.8-2 4.2 2.4-.8 3.3c-.2.8-.9 1.4-1.8 1.4C9.5 20 4 14.5 4 7.8c0-.9.6-1.6 1.4-1.8l1.9-.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>{{ section.settings.phone | escape }}</span>
    </a>

    <p class="shopcart-announcement__offer">
      {{ section.settings.message | escape }}
      {%- if section.settings.link_label != blank -%}
        <span aria-hidden="true">|</span>
        <a href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </p>

    <span class="shopcart-announcement__item shopcart-announcement__language">
      {{ section.settings.language_label | escape }}
      <svg aria-hidden="true" viewBox="0 0 12 8"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </span>
  </div>
</aside>

<style>
  .shopcart-announcement { background: #064a38; color: #fff; font-size: 12px; }
  .shopcart-announcement__inner { min-height: 32px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; }
  .shopcart-announcement__item { display: inline-flex; align-items: center; gap: 6px; color: inherit; text-decoration: none; }
  .shopcart-announcement__item svg { width: 14px; height: 14px; flex: 0 0 auto; }
  .shopcart-announcement__offer { margin: 0; display: flex; align-items: center; gap: 12px; }
  .shopcart-announcement__offer a { color: inherit; font-weight: 700; text-underline-offset: 3px; }
  .shopcart-announcement__language { justify-self: end; }
  .shopcart-announcement__language svg { width: 9px; }

  @media screen and (max-width: 749px) {
    .shopcart-announcement__inner { display: flex; justify-content: center; min-height: 36px; padding-inline: 16px; }
    .shopcart-announcement__phone,
    .shopcart-announcement__language { display: none; }
    .shopcart-announcement__offer { text-align: center; gap: 8px; font-size: 11px; }
  }
</style>

{% schema %}
{
  "name": "Barra promocional",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Rótulo acessível", "default": "Informações da loja" },
    { "type": "text", "id": "phone", "label": "Telefone", "default": "+55 11 2345-6789" },
    { "type": "text", "id": "message", "label": "Mensagem", "default": "Ganhe até 50% OFF em itens selecionados" },
    { "type": "text", "id": "link_label", "label": "Texto do link", "default": "Comprar agora" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "language_label", "label": "Idioma exibido", "default": "PT-BR" }
  ],
  "presets": [{ "name": "Barra promocional" }],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
