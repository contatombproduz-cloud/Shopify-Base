{{ 'bababo-editable.css' | asset_url | stylesheet_tag }}

<section class="bababo-section" style="background: {{ section.settings.background }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="bababo-shell">
    <div class="bababo-promo-banner">
      <div class="bababo-promo-banner__image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}
        {% else %}
          <img src="{{ 'bababo-promo-gifts.png' | asset_url }}" alt="{{ section.settings.image_alt }}" width="1800" height="917" loading="lazy">
        {% endif %}
      </div>
      <div class="bababo-promo-banner__content">
        {% if section.settings.kicker != blank %}<span class="bababo-kicker">{{ section.settings.kicker }}</span>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
        <div class="bababo-actions">
          {% if section.settings.button_label != blank %}
            <a class="bababo-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank %}
            <a class="bababo-button bababo-button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bababo - Banner promo",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem de fundo" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo da imagem", "default": "Presentes e brinquedos Bababo Kids" },
    { "type": "text", "id": "kicker", "label": "Etiqueta", "default": "🎁 Presentes especiais" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Uma loja pronta para encantar" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Use este banner para campanhas de datas comemorativas, lançamentos e linhas mais vendidas." },
    { "type": "text", "id": "button_label", "label": "Texto do botão principal", "default": "Ver ofertas" },
    { "type": "url", "id": "button_link", "label": "Link do botão principal" },
    { "type": "text", "id": "secondary_label", "label": "Texto do botão secundário", "default": "Buscar presentes" },
    { "type": "url", "id": "secondary_link", "label": "Link do botão secundário" },
    { "type": "color", "id": "background", "label": "Fundo da seção", "default": "#fff7fb" },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [
    { "name": "Bababo - Banner promocional" }
  ]
}
{% endschema %}
