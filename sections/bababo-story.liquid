{{ 'bababo-editable.css' | asset_url | stylesheet_tag }}

<section class="bababo-section bababo-page-bg" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="bababo-shell">
    <div class="bababo-card" style="--bababo-radius: 28px; padding: clamp(22px, 5vw, 48px);">
      <div class="bababo-story-grid">
        <div class="bababo-story-logo">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}
          {% else %}
            <img src="{{ 'bababo-logo-large.png' | asset_url }}" alt="{{ section.settings.image_alt }}" width="900" height="560" loading="lazy">
          {% endif %}
        </div>
        <div>
          <h2>{{ section.settings.heading }}</h2>
          {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
          <div class="bababo-actions">
            {% if section.settings.primary_label != blank %}
              <a class="bababo-button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
            {% endif %}
            {% if section.settings.secondary_label != blank %}
              <a class="bababo-button bababo-button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bababo - História",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo da imagem", "default": "Bababo Kids" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Diversão que conecta!" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "A marca Bababo Kids conecta crianças, famílias e momentos de brincadeira. A identidade usa cores vivas, formas macias e uma linguagem próxima para transformar a compra em uma experiência divertida desde a primeira tela." },
    { "type": "text", "id": "primary_label", "label": "Texto do botão principal", "default": "Conhecer produtos" },
    { "type": "url", "id": "primary_link", "label": "Link do botão principal" },
    { "type": "text", "id": "secondary_label", "label": "Texto do botão secundário", "default": "Buscar mordedores" },
    { "type": "url", "id": "secondary_link", "label": "Link do botão secundário" },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [
    { "name": "Bababo - História" }
  ]
}
{% endschema %}
