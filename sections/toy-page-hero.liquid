<section class="toy-page-hero" data-toy-parallax-section>
  <div class="toy-page-hero__backdrop" data-toy-parallax="0.1">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '700, 1200, 1600, 2000', alt: section.settings.image_alt }}
    {% else %}
      <img src="{{ 'toy-store-footer-world.png' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="2172" height="724" loading="eager">
    {% endif %}
  </div>
  <div class="page-width toy-page-hero__inner" data-toy-tilt>
    <div class="toy-page-hero__copy" data-toy-parallax="-0.08">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      <div>{{ section.settings.text }}</div>
      {% if section.settings.button_label != blank %}<a class="toy-cloud-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Página infantil - Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "image_alt", "label": "Descrição da imagem", "default": "Mundo mágico de brinquedos" },
    { "type": "text", "id": "eyebrow", "label": "Chamada", "default": "Bem-vindo à brincadeira" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Uma página cheia de imaginação" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Descubra histórias, ideias e experiências pensadas para toda a família.</p>" },
    { "type": "text", "id": "button_label", "label": "Botão" },
    { "type": "url", "id": "button_link", "label": "Link" }
  ],
  "presets": [{ "name": "Página infantil - Hero" }]
}
{% endschema %}
