{%- liquid
  assign featured_collection = collections[section.settings.collection]
  if featured_collection == blank
    assign featured_collection = collections['all']
  endif
  assign product_limit = section.settings.products_to_show | plus: 0
-%}

<section class="shopcart-showcase page-width" data-section-id="{{ section.id }}">
  <div class="shopcart-showcase__toolbar" aria-label="Filtros de produtos">
    <div class="shopcart-showcase__filters">
      {%- for block in section.blocks -%}
        <a class="shopcart-filter" href="{{ block.settings.link | default: featured_collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {{ block.settings.label | escape }}
          <svg aria-hidden="true" viewBox="0 0 12 8"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
      {%- endfor -%}
    </div>
    <a class="shopcart-sort" href="{{ featured_collection.url | default: routes.all_products_collection_url }}?sort_by=best-selling">
      Ordenar por
      <svg aria-hidden="true" viewBox="0 0 12 8"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </a>
  </div>

  <div class="shopcart-showcase__heading-row">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="shopcart-showcase__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="shopcart-showcase__heading">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.show_view_all and featured_collection != blank -%}
      <a class="shopcart-showcase__view-all" href="{{ featured_collection.url }}">Ver todos <span aria-hidden="true">→</span></a>
    {%- endif -%}
  </div>

  <ul class="shopcart-product-grid" role="list" style="--shopcart-columns: {{ section.settings.columns_desktop }}">
    {%- if featured_collection.products.size > 0 -%}
      {%- for product in featured_collection.products limit: product_limit -%}
        <li>{% render 'card-product-shopcart', card_product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..8) -%}
        {%- liquid
          assign placeholder_index = i | modulo: 6 | plus: 1
          assign placeholder_name = 'product-' | append: placeholder_index
        -%}
        <li>
          <article class="shopcart-card shopcart-card--placeholder">
            <div class="shopcart-card__media">
              {{ placeholder_name | placeholder_svg_tag: 'shopcart-card__image placeholder-svg' }}
              <span class="shopcart-card__favorite" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M20.8 4.9a5.4 5.4 0 0 0-7.7 0L12 6l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.4a5.4 5.4 0 0 0 0-7.7Z" stroke="currentColor" stroke-width="1.7"/></svg>
              </span>
            </div>
            <div class="shopcart-card__info">
              <div class="shopcart-card__title-row"><h3 class="shopcart-card__title">Headphone Premium</h3><strong>R$ 299</strong></div>
              <p class="shopcart-card__description">Som potente, conforto e bateria para o dia todo.</p>
              <button class="shopcart-card__add" type="button" disabled>Adicionar ao carrinho</button>
            </div>
          </article>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</section>

<style>
  .shopcart-showcase { padding-top: clamp(34px, 5vw, 60px); padding-bottom: clamp(56px, 7vw, 88px); }
  .shopcart-showcase__toolbar { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: 42px; }
  .shopcart-showcase__filters { display: flex; flex-wrap: wrap; gap: 10px; }
  .shopcart-filter,
  .shopcart-sort { min-height: 38px; display: inline-flex; align-items: center; gap: 9px; padding: 8px 14px; border: 1px solid #e4e8e6; border-radius: 999px; background: #f4f6f5; color: #25332e; font-size: 13px; font-weight: 700; text-decoration: none; transition: border-color .2s ease, background-color .2s ease, transform .2s ease; }
  .shopcart-filter:hover,
  .shopcart-sort:hover { border-color: #97aea6; background: #fff; transform: translateY(-1px); }
  .shopcart-filter svg,
  .shopcart-sort svg { width: 9px; height: 7px; }
  .shopcart-sort { flex: 0 0 auto; background: #fff; }
  .shopcart-showcase__heading-row { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 25px; }
  .shopcart-showcase__eyebrow { margin: 0 0 6px; color: #557068; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .shopcart-showcase__heading { margin: 0; color: #10251f; font-size: clamp(25px, 3vw, 34px); letter-spacing: -.035em; }
  .shopcart-showcase__view-all { color: #064a38; font-weight: 800; text-decoration: none; }
  .shopcart-product-grid { display: grid; grid-template-columns: repeat(var(--shopcart-columns, 4), minmax(0, 1fr)); gap: 34px 22px; margin: 0; padding: 0; list-style: none; }
  .shopcart-card { height: 100%; display: flex; flex-direction: column; }
  .shopcart-card__media { position: relative; aspect-ratio: 1 / .93; overflow: hidden; border-radius: 12px; background: #f5f6f6; }
  .shopcart-card__image-link { display: block; width: 100%; height: 100%; }
  .shopcart-card__image { width: 100%; height: 100%; display: block; object-fit: contain; padding: 18px; transition: transform .35s ease; }
  .shopcart-card:hover .shopcart-card__image { transform: scale(1.035); }
  .shopcart-card__favorite { position: absolute; top: 12px; right: 12px; width: 34px; height: 34px; display: grid; place-items: center; padding: 0; border: 1px solid #e3e7e5; border-radius: 50%; background: rgba(255,255,255,.93); color: #23312c; cursor: pointer; }
  .shopcart-card__favorite svg { width: 17px; height: 17px; }
  .shopcart-card__favorite[aria-pressed='true'] { color: #fff; background: #064a38; border-color: #064a38; }
  .shopcart-card__favorite[aria-pressed='true'] path { fill: currentColor; }
  .shopcart-card__info { flex: 1; display: flex; flex-direction: column; padding-top: 13px; }
  .shopcart-card__title-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 12px; }
  .shopcart-card__title { margin: 0; font-size: 15px; line-height: 1.25; }
  .shopcart-card__title a { color: #11231e; text-decoration: none; }
  .shopcart-card__description { min-height: 32px; margin: 6px 0 0; color: #68736f; font-size: 11px; line-height: 1.4; }
  .shopcart-card__price { color: #10251f; font-size: 14px; font-weight: 800; white-space: nowrap; }
  .shopcart-card__price .price__badge { display: none; }
  .shopcart-card__price .price__compare { color: #87908d; margin-right: 5px; font-size: 11px; font-weight: 400; }
  .shopcart-card__rating { display: flex; align-items: center; gap: 5px; min-height: 20px; margin-top: 5px; color: #18a53b; font-size: 11px; letter-spacing: .04em; }
  .shopcart-card__rating small { color: #606c68; letter-spacing: 0; }
  .shopcart-card__form { margin-top: auto; padding-top: 10px; }
  .shopcart-card__add { min-height: 38px; padding: 8px 15px; border: 1px solid #064a38; border-radius: 999px; background: #fff; color: #064a38; font: inherit; font-size: 12px; font-weight: 800; cursor: pointer; transition: color .2s ease, background-color .2s ease; }
  .shopcart-card__add:hover { background: #064a38; color: #fff; }
  .shopcart-card__add:disabled { opacity: .48; cursor: not-allowed; }
  .shopcart-card--placeholder .shopcart-card__image { padding: 30px; }

  @media screen and (max-width: 989px) {
    .shopcart-product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 16px; }
    .shopcart-showcase__toolbar { align-items: flex-start; margin-bottom: 34px; }
    .shopcart-showcase__filters { flex-wrap: nowrap; max-width: 100%; overflow-x: auto; padding-bottom: 5px; scrollbar-width: none; }
    .shopcart-showcase__filters::-webkit-scrollbar { display: none; }
    .shopcart-filter { flex: 0 0 auto; }
  }
  @media screen and (max-width: 599px) {
    .shopcart-showcase__toolbar { display: block; }
    .shopcart-sort { margin-top: 12px; }
    .shopcart-showcase__heading-row { align-items: center; }
    .shopcart-showcase__view-all { font-size: 13px; }
    .shopcart-card__media { aspect-ratio: 1; }
    .shopcart-card__image { padding: 10px; }
    .shopcart-card__title-row { display: block; }
    .shopcart-card__price { margin-top: 4px; }
    .shopcart-card__add { width: 100%; padding-inline: 8px; }
  }
</style>

<script>
  document.addEventListener('click', function (event) {
    var button = event.target.closest('.shopcart-card__favorite');
    if (!button || !button.hasAttribute('aria-pressed')) return;
    var isPressed = button.getAttribute('aria-pressed') === 'true';
    button.setAttribute('aria-pressed', String(!isPressed));
  });
</script>

{% schema %}
{
  "name": "Vitrine Shopcart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Escolhas que combinam com você" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Fones para você" },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "default": 8, "label": "Produtos exibidos" },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 5, "step": 1, "default": 4, "label": "Colunas no desktop" },
    { "type": "checkbox", "id": "show_view_all", "default": true, "label": "Mostrar link Ver todos" }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtro",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Categoria" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vitrine Shopcart",
      "blocks": [
        { "type": "filter", "settings": { "label": "Tipo de fone" } },
        { "type": "filter", "settings": { "label": "Preço" } },
        { "type": "filter", "settings": { "label": "Avaliação" } },
        { "type": "filter", "settings": { "label": "Cor" } },
        { "type": "filter", "settings": { "label": "Oferta" } }
      ]
    }
  ]
}
{% endschema %}
